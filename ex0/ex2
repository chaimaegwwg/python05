class TransformStage:
    def proces(self, data):
        if data is None:
            print("Error: No data provided")
            return
        value = data["payload"]["value"]
        if  20 <= value <= 25:
            status = "Normal range"
        else:
            status = "Alert"
        data["metadata"]["Status"] = status
        data["metadata"]["processed_at"] = "2026-02-16T12:00:00Z"

        print("Stage 2: Data transformation and enrichment")
        return data

class OutputStage:
    def proces(self, data):
        if data is None:
            return "Error: No data provided"

        print("Stage 3: Output formatting and delivery")

        if isinstance(data["payload"] , list):
            lenn = len(data["payload"])
            summ = sum(data["payload"])
            av = summ / lenn
            # data["payload"] = av
            return f"Output: Stream summary: {lenn} readings, avg: {av:.2f}°C"
        else:
            value = data["payload"]["value"]
            unit = data["payload"]["unit"] 
            status = data["metadata"]["Status"]
            return f"Output: Processed {data['payload']['sensor']} reading: {value}{unit} ({status})"
        # return f"Processed {data['payload']['sensor']} reading: {value}{unit} ({status})"

