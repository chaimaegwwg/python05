class InputStage:
    def proces(self, data):
        try:
            if data is None:
                raise ValueError("No data provided")
            if not isinstance(data, (dict, list, str)):
                raise ValueError("Data not Valid ")
            # if isinstance(data, list):
            #     dataa = int(data)
            #     raise ValueError("Data not Valid ")
            if isinstance(data, dict):
                data_required = ["sensor","value" , "unit"]
                for key in data_required:
                    if key not in data:
                        raise KeyError(f"Missing required key: {key}")
                if not isinstance(data["sensor"], str):
                    raise TypeError("sensor must be a string")
                if not isinstance(data["value"],( int, float)):
                    raise TypeError("value must be a number")
                if not isinstance(data["unit"], str):
                    raise TypeError("unit must be a string")
            internal_data = {
                "type": "sensor_reading",
                "payload": data,
                "metadata": {"validated": True}
                }
            print("Stage 1: Input validation and parsing")
            return internal_data
        except ValueError as e:
            print("Error:", e)
            return None
        
        return None

