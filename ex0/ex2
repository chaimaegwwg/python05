class JSONAdapter(ProcessingPipeline):
    def process(self, data):
        input_data = InputStage()
        data_adapter = input_data.proces(data)
        print("Input:", data)
        print()
        adapter = TransformStage()
        data_ad = adapter.proces(data_adapter)
        if data_ad is None:
            print("No data provided\n")
            return 
        else:
            print("Transform: Enriched with metadata and validation\n")
        
        outputstage = OutputStage()
        res = outputstage.proces(data_ad) 
        print(res)
        

