class StreamAdapter(ProcessingPipeline):
    def process(self, data): 
        input_parsing = InputStage()
        data_adapter = input_parsing.proces(data)
        print("Input:", data)
        print("Transform: Aggregated and filtered")
        outputstage = OutputStage()
        res = outputstage.proces(data_adapter) 
        print(res)


def error_recovery_test():
    print("=== Error Recovery Test ===")
    print("Simulating pipeline failure...")
    raw_data = {"sensor": "temp", "value": "INVALID", "unit": "C"}
    input_stage = InputStage()
    processed_data = input_stage.proces(raw_data)
    trans = TransformStage()
    try:
        trans_data = trans.proces(processed_data)
        if trans_data is None:
            raise ValueError("Invalid data format")

    except ValueError as e:
        print("Error detected in Stage 2:", e)
        print("Recovery initiated: Switching to backup processor")
    raw_data["value"] = 23
    input_stage = InputStage()
    processed_data = input_stage.proces(raw_data)
    try:
        trans_data = trans.proces(processed_data)
        if trans_data is None:
            raise ValueError("Invalid data format")
        print("Recovery successful: Pipeline restored, processing resumed")
    except ValueError as e:
        print("Error detected in Stage 2:", e)




