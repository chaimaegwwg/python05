from abc import ABC, abstractmethod
from typing import Dict, Union
from typing import Any


class DataStream(ABC):
    def __init__(self, statut, type):
        self.statut = statut
        self.type = type

    @abstractmethod
    def process_batch(self, data_batch: list[Any]) -> str:
        pass


class SensorStream(DataStream):
    def __init__(self, statut, type, analys, temp):
        super().__init__(statut, type)
        self.analys = analys
        self.temp = temp

    def get_info(self) -> str:
        print("Initializing Sensor Stream...")
        return f"Stream ID: {self.statut}, Type: {self.type}"

    def process_batch(self, data_batch: list[Any]) -> str:
        try:
            count = len(data_batch)
            if count == 3:
                msg = (f"Processing sensor batch: [temp:{data_batch[0]}, "
                       f"humidity:{data_batch[1]}, pressure:{data_batch[2]}]")
                return msg
            else:
                raise ValueError("please inter 3 argument")
        except ValueError as e:
            print("Error:", e)

    def get_stats(self) -> Dict[str, Union[str, int, float]]:
        dc = {
            "Sensor analysis": f"{self.analys} readings processed,",
            "avg temp": f"{self.temp}°C",
        }
        return dc


class TransactionStream(SensorStream):
    def __init__(self, statut, type, analys, temp):
        super().__init__(statut, type, analys, temp)

    def get_info(self) -> str:
        print("Initializing Transaction Stream...")
        return f"Stream ID: {self.statut}, Type: {self.type}"

    def process_batch(self, data_batch: list[Any]) -> str:
        try:
            count = len(data_batch)
            if count == 3:
                msg = (f"Processing transaction batch: [buy:"
                       f"{data_batch[0]}, sell:{data_batch[1]}, "
                       f"buy:{data_batch[2]}]")
                return msg
            else:
                raise ValueError("please inter 3 argument")
        except ValueError as e:
            print("Error:", e)

    def get_stats(self) -> Dict[str, Union[str, int, float]]:
        dc = {
            "Transaction analysis": f"{self.analys} operations,",
            "net flow:": f"+{self.temp} units",
        }
        return dc


class EventStream(TransactionStream):
    def __init__(self, statut, type, analys, temp):
        super().__init__(statut, type, analys, temp)

    def get_info(self) -> str:
        print("Initializing Transaction Stream...")
        return f"Stream ID: {self.statut}, Type: {self.type}"

    def process_batch(self, data_batch: list[Any]) -> str:
        try:
            count = len(data_batch)
            if count == 3:
                join = ", ".join(data_batch)
                print(join)
                return f"Processing event batch: [{join}]"
            else:
                raise ValueError("please inter 3 argument")
        except ValueError as e:
            print("Error:", e)

    def get_stats(self) -> Dict[str, Union[str, int, float]]:
        return {
            "Event analysis": (
                f"{self.analys} events, "
                f"{self.temp} error detected")
        }


class StreamProcessor:
    def __init__(self, typee, stream):
        self.stream = stream
        self.typee = typee

    def process_stream(self):
        stream = len(self.stream)
        if self.typee == "sensor":
            return f"- Sensor data: {stream} readings processed"
        elif self.typee == "transaction":
            return f"- Transaction data: {stream} operations processed"
        elif self.typee == "event":
            return f"- Event data: {stream} events processed"
        else:
            return (
                "- Please enter one of these types: "
                "sensor, transaction, or event"
                )

    def filter_stream(self, priority="high"):
        y = []
        for x in self.stream:
            if x["priority"] == priority:
                y.append(x)
        count = len(y)
        y = []
        for x in self.stream:
            if x["priority"] == "critical":
                y.append(x)
        count_critical = len(y)
        return (
            f"Stream filtering active: {priority} data only\n"
            f"Filtered results: {count_critical} "
            f"critical sensor alerts, {count} large transaction"
            )


def main():
    print("=== CODE NEXUS - POLYMORPHIC STREAM SYSTEM ===\n")
