         [".",".",".",".","8",".",".","7","9"]]

class Helper:
    def __init__(self, row, col):
        self.last_num = set()
        self.pos = (row, col)

class Solution(object):  
    def is_valid_block(self ,block, num):
        check = 0
        for i in range(9):
            if block[i] == num:
                check +=1
        if check > 1:
            return False 
        return True

    def is_valid(self, num , pos , sudo):
        # check the row
        for i in range(9):
            if sudo[pos[0]][i] == num and pos[1] != i:
                return False

        # check the col
        for j in range(9):
            if sudo[j][pos[1]] == num and pos[0] != j:
                return False

        row = 0
        col = 0
        check = 0
        block = []
        # i, j = pos
        #check the square
        start_row = (pos[0] // 3)*3
        start_col = (pos[1] // 3)*3
        for i in range(3):
            for j in range(3):
                row = start_row + i
                col = start_col  + j 
                block.append(sudo[row][col])
        if not self.is_valid_block(block,num): return False

        return True

    #search on position of 0
    def empty_position(self , sudo):
        for i in range(9):
            for j in range(9):
                if sudo[i][j] == ".":
                    # print(i,j)
                    return (i, j)
        return None


    def print_grid(self , sudo):
        for i in range(9):
            if i % 3 == 0 and i != 0:
                print("--- + --- + ----")
            for j in range(9):
                if j % 3 == 0 and j !=0:
                    print(" | ",end = "")
                print(sudo[i][j],end = "")
            print()


    def solveSudoku(self, sudoku):
        stack = []
        pos = self.empty_position(sudoku)
        check = 0
        i , j = pos
    

        stack.append(Helper( i , j))
        helper = stack
        while stack:
            check = 0
            # n = 0
            helper = stack[-1]
            # print("Pos:", helper.pos, "Last numbers tried:", helper.last_num)
            # pos, num_last = stack[-1]
            for num in range(1, 10):
                if num in helper.last_num:
                    continue
                else:

                    is_validate = self.is_valid(num , helper.pos , sudoku)
                    if is_validate == True:
                        i, j= helper.pos
                        sudoku[i][j] = num
                        helper.last_num.add(num)

                        check = 1
                        break
                    
            if check == 0:
                x, y= helper.pos
                # print(f"Backtracking from {helper.pos}, resetting value {sudoku[x][y]}")
                sudoku[x][y] = "."
                stack.pop()

                # check = 1
            #if that is the first time that it creat like if not == 0 that mean is the last one found a partener 
            else:
                pos = self.empty_position(sudoku)
                if pos is None or not stack :
                    break 
                # print("Next empty position:", pos)

                (i , j) = pos
                stack.append(Helper(i, j))


            if pos is None or not stack :
                break 
          
        self.print_grid(sudoku)

    # solveSudoku(sudoku)

s = Solution()
